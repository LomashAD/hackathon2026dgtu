# Адрес Ollama. Нативно на macOS (GPU/Metal): http://localhost:11434
# В Docker Compose: http://ollama:11434; Docker на Mac + нативная Ollama: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
# Отключение телеметрии сторонних библиотек (никакого исходящего трафика)
ANONYMIZED_TELEMETRY=False
HOST=0.0.0.0
PORT=8000
